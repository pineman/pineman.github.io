<meta charset="UTF-8" />
<link rel="icon" type="image/x-icon" href="<%= site_link("favicon.ico") %>" />
<link rel="stylesheet" href="<%= site_link("style.css") %>" />
<link rel="alternate" type="application/atom+xml" title="pineman" href="<%= site_link("atom.xml") %>" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light dark" />
<meta name="author" content="João Pinheiro" />
<meta name="keywords" content="technology computer software engineering" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="João Pinheiro" />
<script type="speculationrules">
{
  "prerender": [{
    "where": {
      "or": [
        { "href_matches": "/index.html" },
        { "href_matches": "/posts/*.html" }
      ]
    },
    "eagerness": "immediate"
  }, {
    "where": {
      "and": [
        { "href_matches": "/*.html" },
        { "not": { "href_matches": "/index.html" } },
        { "not": { "href_matches": "/posts/*.html" } }
      ]
    },
    "eagerness": "moderate"
  }]
}
</script>
