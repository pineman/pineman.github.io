<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <author>
    <name>pineman</name>
  </author>
  <id><%= SITE_ROOT %>/</id>
  <link href="<%= SITE_ROOT %>/atom.xml" rel="self"/>
  <logo><%= SITE_ROOT %>/assets/me.webp</logo>
  <title>pineman</title>
  <updated><%= posts.last.date.iso8601 %></updated>
<% posts.each do |post| %>
  <entry>
    <id><%= SITE_ROOT %>/<%= post.url %></id>
    <link href="<%= SITE_ROOT %>/<%= post.url %>"/>
    <title><%= post.title %></title>
    <published><%= post.date.iso8601 %></published>
    <updated><%= post.date.iso8601 %></updated>
    <summary type="html"><%= post.feed_html %></summary>
  </entry>
<% end %>
</feed>
