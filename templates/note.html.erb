<!DOCTYPE html>
<html lang="en-US">
<head>
  <%== render(TEMPLATE_HEAD) %>
  <%== render(TEMPLATE_ARTICLE_HEAD) %>
  <meta property="og:url" content="<%= SITE_ROOT %>/notes/<%= note.name %>.html" />
  <title><%= note.name %></title>
  <meta property="og:title" content="<%= note.name %>" />
  <meta name="twitter:card" content="summary" />
  <link rel="stylesheet" href="<%= site_link("assets/oceanicnext.min.css") %>">
</head>
<body>
<div id="wrap">
<nav><a href="<%= site_link("notes.html") %>">&lt; back</a></nav>
<main>
<article>
  <h1><%= note.name %></h1>
  <%== note.html %>
</article>
</main>
<footer><a href="<%= site_link("notes.html") %>">&lt; back</a></footer>
</div>
<script src="<%= site_link("assets/highlight.min.js") %>"></script>
<script>hljs.highlightAll();</script>
</body>
</html>
