<!DOCTYPE html>
<html lang="en-US">
<head>
  <%== render_erb('templates/head.html.erb', binding) %>
  <%== render_erb('templates/article-head.html.erb', binding) %>
  <meta property="og:url" content="<%= SITE_ROOT %>/notes/<%= note.name %>.html" />
  <title><%= note.name %></title>
  <meta property="og:title" content="<%= note.name %>" />
  <meta name="twitter:card" content="summary" />
</head>
<body>
<div id="wrap">
<nav><a href="<%= site_link("notes.html") %>">&lt; back</a></nav>
<main>
<article>
  <h1><%= note.name %></h1>
  <%== note.html %>
</article>
</main>
<footer><a href="<%= site_link("notes.html") %>">&lt; back</a></footer>
</div>
</body>
</html>
