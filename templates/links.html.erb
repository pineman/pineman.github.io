<!DOCTYPE html>
<html lang="en-US">
<head>
  <%== render_erb('templates/head.html.erb', binding) %>
  <%== render_erb('templates/article-head.html.erb', binding) %>
  <link rel="alternate" type="text/markdown" href="<%= site_link("links.md") %>">
  <meta property="og:url" content="<%= SITE_ROOT %>/links.html" />
  <meta property="article:published_time" content="<%= updated.iso8601 %>" />
  <meta property="article:modified_time" content="<%= updated.iso8601 %>" />
  <title>What I read</title>
  <meta property="og:title" content="What I read" />
  <meta name="description" content="What I read" />
  <meta property="og:description" content="What I read" />
  <meta name="twitter:card" content="summary" />
</head>
<body>
<div id="wrap">
<nav><a href="<%= site_link("index.html") %>">&lt; back</a></nav>
<main>
<article>
  <h1>Some of what I read on the internets</h1>
<% months.each do |month, items| %>
  <h2 class="links-month"><%= month %></h2>
  <ul>
  <% items.each do |item| %>
    <% if item.match?(%r{\Ahttps?://}) %>
      <% url, description = item.split(" ", 2) %>
    <li><a href="<%= url %>"><%= url %></a><% if description %> <%= description %><% end %></li>
    <% else %>
    <li><%= item %></li>
    <% end %>
  <% end %>
  </ul>
<% end %>
</article>
</main>
<footer><a href="<%= site_link("index.html") %>">&lt; back</a></footer>
</div>
</body>
</html>
