<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      margin: 0;
      width: 1200px;
      height: 630px;
    }
    .container {
      background: #1d1e20;
      font-family: Menlo, monospace; /* I'll always have a mac right? */
      color: #dadadb;
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 50px;
      box-sizing: border-box;
    }
    .footer {
      margin-top: auto;
      font-size: 30px;
      align-self: flex-end;
    }
    h1 {
      margin: 0;
      font-size: 60px;
    }
    p {
      font-size: 40px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1><%= post.title %></h1>
    <p><%= post.text_descr %></p>
    <div class="footer">
      <span>pineman <%= post.date.strftime("%Y-%m-%d") %></span>
    </div>
  </div>
</body>
</html>
